# Copy to a user-private file (chmod 600) outside the source tree.
# Generate each value independently, for example: openssl rand -hex 32
NEO4J_PASSWORD=replace-with-a-long-random-password
QDRANT_API_KEY=replace-with-a-different-long-random-key

# All published dependency ports remain bound to loopback.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_HTTP_PORT=6333
