  "events": [
    "message.upsert (data is message DTO)",
    "snapshot.changed (reconcile scoped snapshot, including resolved approvals)",
    "device.revoked",
    "remote.disabled",
    "attachment.progress (data is upload DTO; cursor is opaque like other events)"
  ],
  "notes": "All operations are capability negotiated. Absent operation must have no enabled control. Unsupported forms/unsafe active providers expose deny/Stop only. All mutation failures preserve drafts. Connection loss never queues a new action. On ambiguous mutation query commands.status with original ID. All snapshot arrays replace cached scope; removed resources must be purged. Reconnect always supports full scoped snapshot even without retained replay. No command retry with a new ID without review. TLS trust exactly paired SPKI and valid certificate/SAN. No network pairing endpoint. Session summaries set draftIncluded:false; fetch sessions.get before enabling Send. A positive draftAttachmentCount means the desktop draft must be reviewed there; mobile draft edits and sends do not discard those attachments. sync.open sessionIds is authoritative for cache removal; use sessions.list with nextSessionOffset to hydrate omitted summaries. Submitted Ollama image files can be removed after a completed turn because full image context is persisted. Native path inputs remain until session removal, local clear, or device revocation. Command outcomes are redacted across device scopeVersion changes. Memory invalidation clears retained result payloads. cacheEpoch changes clear phone transcript and transient memory views. Memory CAS revisions above 9007199254740991 are rejected.",
  "media": {
    "binaryFrame": "16-byte UUID, 8-byte unsigned big endian offset, up to 262144 payload bytes; single outstanding chunk per upload; wait attachment.progress before next chunk",
    "upload": "attachments.begin signed; binary chunks; attachments.status after reconnect; attachments.commit signed; session-specific opaque IDs in signed sessions.send",
    "preview": "approvals.preview returns readId,size,mime,sha256,imageDigest,expiresAt. attachments.read sends binary read frame then response {bytes:payloadLength}. Verify full preview sha256, show preview, add imageDigest to signed approvals.answer for image Allow. Handles expire or become invalid when approval resolves.",
    "operations": {
      "attachments.begin": {
        "params": {
          "sessionId": "uuid",
          "size": "1..10485760",
          "mime": "image/png|image/jpeg|image/webp",
          "sha256": "base64url SHA256 bytes"
        },
        "result": {
          "attachmentId": "uuid",
          "uploadId": "uuid",
          "size": 0,
          "offset": 0,
          "mime": "image/png",
          "sha256": "hash",
          "status": "uploading",
          "expiresAt": 0
        }
      },
      "attachments.status": {
        "params": {
          "attachmentId": "uuid"
        },
        "result": "same upload DTO"
      },
      "attachments.commit": {
        "params": {
          "attachmentId": "uuid"
        },
        "result": "same DTO with status ready and width/height"
      },
      "attachments.abort": {
        "params": {
          "attachmentId": "uuid"
        },
        "result": true
      },
      "approvals.preview": {
        "params": {
          "approvalId": "uuid",
          "revision": "1",
          "digest": "hash"
        },
        "result": {
          "readId": "uuid",
