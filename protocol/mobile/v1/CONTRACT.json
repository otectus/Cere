  "path": "/mobile/v1",
  "subprotocol": "cere.mobile.v1",
  "encoding": "RFC8785 canonical JSON; SHA256 digests and P256 SHA256withECDSA DER signatures use unpadded base64url. Public keys are X509 SPKI DER base64url.",
  "pairing": {
    "uri": "cere-pair://v1/<base64url(canonical JSON)>",
    "offer": {
      "type": "offer",
      "v": 1,
      "desktopId": "uuid",
      "name": "Cere",
      "certificate": "DER base64url",
      "spki": "sha256(SPKI bytes)",
      "identityKey": "SPKI base64url",
      "endpoints": [
        "wss://192.168.1.2:8443/mobile/v1"
      ],
      "pairingId": "uuid",
      "nonce": "32 bytes base64url",
      "expiresAt": 0,
      "signature": "DER base64url",
      "actionAuthentication": "biometric | trusted-device (optional; absent means biometric)",
      "replacesDeviceId": "optional UUID of the existing phone being replaced on the same desktop"
    },
    "offerSignatureTranscript": {
      "domain": "cere.mobile.pair.offer.v1",
      "offer": "entire offer object without signature"
    },
    "responseBody": {
      "type": "response",
      "v": 1,
      "desktopId": "uuid",
      "pairingId": "uuid",
      "offerDigest": "digest of complete signed offer",
      "nonce": "offer nonce",
      "deviceId": "uuid",
      "name": "Phone",
      "keyVersion": 1,
      "connectionKey": "SPKI base64url",
      "actionKey": "SPKI base64url",
      "deviceNonce": "32 bytes base64url"
    },
    "responseSignatureTranscript": {
      "domain": "cere.mobile.pair.response.v1",
      "response": "responseBody"
    },
    "response": "responseBody plus connectionProof and actionProof signatures of responseSignatureTranscript using respective keys",
    "sas": "SHA256 UTF8(offerDigest + '.' + digest(complete signed response)); first six bytes index sas-words.json; join words with spaces",
    "maximumUriBytes": 2000,
    "replacement": "A signed replacesDeviceId must match the saved desktop/device. Replacement reuses project IDs, revokes old authority, preserves local drafts/cache, and requires reconciliation of pending commands first. Policy is chosen locally in the signed offer, not supplied by the phone."
  },
